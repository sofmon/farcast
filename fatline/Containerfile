# FatLine data-plane image — the REFERENCE build.
#
# The canonical image is assembled by `farcast connect` itself: it compiles the
# binary with the local Go toolchain and pushes it onto the same digest-pinned
# distroless base through an in-process OCI client, with no container engine on
# the operator's machine (ADR 0007). This Containerfile reproduces that image
# independently — for verification, or for building with an engine if you have
# one. Build from the REPOSITORY ROOT (the context needs the root go.mod +
# vendor/ + every package fatline imports):
#
#   docker build --platform linux/amd64 -f fatline/Containerfile -t <registry>/fatline:<tag> .
#
# Pass --platform for the CLUSTER's architecture (GKE Autopilot schedules amd64
# nodes by default) — the build stage runs natively on the host and Go
# cross-compiles to the target, so this is fast even on an arm64 Mac.
#
# `farcast connect` deploys this image (its --fatline-image flag). The runtime
# shape matches fatline/deploy's securityContext: a static binary on distroless
# nonroot (uid 65532), so the workload runs as non-root with a read-only root
# filesystem. Args (--tunnel-listen/--egress-listen/--cert/--key/--ca) are
# supplied by the Deployment, not baked in here.

# Both bases are pinned by digest: tags are mutable, so pinning turns Docker Hub
# and gcr.io into untrusted transports. Bump deliberately, in a reviewed commit.
# The builder tracks go.mod's `toolchain` line, so this reference build and the
# one `farcast connect` performs use the same compiler — keep the two in step
# when either moves. Note this file needs BuildKit (for --platform/$TARGETARCH);
# a plain pre-BuildKit `docker build` will not cross-compile correctly.
FROM --platform=$BUILDPLATFORM golang:1.27@sha256:0ecdc2a9f6156af6451080bfe3d8382a662fcc4e209608c6f919e643453514c1 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY . .
# Static (CGO off), vendored, and cross-compiled to the target platform, so the
# build is hermetic — no module fetch, no emulated compile.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /fatline ./fatline/cmd/fatline

FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7
COPY --from=build /fatline /fatline
ENTRYPOINT ["/fatline"]
